# Public canonical origin. Do not include a trailing slash.
NUXT_PUBLIC_SITE_URL=https://prof-ahmadza.com

# Server-only Supabase configuration. When either value is absent, the app
# explicitly falls back to the bundled demo repository.
NUXT_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Never expose sb_secret_* or legacy service_role values to the browser.
